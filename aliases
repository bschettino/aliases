# Kubernetes
kcoreconsole() {
  kubectl exec -it $(kubectl get pods | grep app-core-rails-console | awk '{print $1}') -- bash
}

kchatconsole() {
  kubectl exec -it $(kubectl get pods | grep app-pipefy-ai-chat-rails-console | awk '{print $1}') -- bash
}

alias reload-kafka-host="sudo sh ~/host_kafka_script.sh"
loginvpn() {
  sudo openfortivpn -c /etc/openfortivpn/my-config <<< $1
}

pipe-ai-local-console() {
  cd $HOME/pipefy-workspace/pipefy-ai;
  docker compose run --rm web bash 
}
